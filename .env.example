DATABASE_URL=jdbc:postgresql://localhost:5432/auth_service
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=change-me

# HS256 secret must be >= 32 bytes. To rotate: set JWT_SECRET to the new key,
# put the old key in JWT_PREVIOUS_SECRETS, bump JWT_KEY_ID, then remove the old key later.
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-characters
JWT_PREVIOUS_SECRETS=
JWT_KEY_ID=current
JWT_ACCESS_TTL=10m
JWT_REFRESH_TTL=30d
JWT_REFRESH_COOKIE_NAME=refresh_token
JWT_REFRESH_COOKIE_SECURE=false
JWT_REFRESH_COOKIE_SAME_SITE=Lax

MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION=15m
REQUIRE_HTTPS=false

CORS_ALLOWED_ORIGINS=http://localhost:5173
